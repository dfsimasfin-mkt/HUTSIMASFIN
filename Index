<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Pecah Telur — Sinarmas Multifinance</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --red: #C8102E;
    --red-dark: #7A0C1E;
    --red-deep: #4A060F;
    --gold: #D4AF37;
    --gold-light: #F3D77C;
    --gold-soft: #FBEFC7;
    --cream: #FFF9F0;
    --ink: #2A1013;
    --ink-soft: #6b4b4f;
    --white: #FFFFFF;
    --ok: #1F8A4C;
    --warn: #B7791F;
    --danger: #C8102E;
    --radius: 18px;
    --shadow: 0 12px 30px rgba(74,6,15,0.18);
    --shadow-sm: 0 4px 12px rgba(74,6,15,0.12);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Inter',sans-serif;
    background:
      radial-gradient(circle at 15% 0%, rgba(212,175,55,0.10), transparent 45%),
      radial-gradient(circle at 100% 100%, rgba(200,16,46,0.06), transparent 40%),
      var(--cream);
    color:var(--ink);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{font-family:'Poppins',sans-serif;}
  button{font-family:inherit;cursor:pointer;}
  input,select,textarea{font-family:inherit;}
  ::selection{background:var(--gold-light);}

  /* ---------- batik-inspired diagonal texture (signature motif) ---------- */
  .batik-strip{
    height:10px;
    width:100%;
    background:
      repeating-linear-gradient(135deg,
        var(--gold) 0 10px,
        var(--red) 10px 20px,
        var(--red-dark) 20px 30px);
    background-size:200% 100%;
  }
  .batik-strip.top{border-radius:0 0 4px 4px;}
  .batik-strip.bottom{border-radius:4px 4px 0 0;}

  /* ---------- app shell ---------- */
  #app{max-width:520px;margin:0 auto;min-height:100vh;background:var(--white);box-shadow:0 0 60px rgba(74,6,15,0.10);position:relative;display:flex;flex-direction:column;}
  .screen{display:none;flex-direction:column;flex:1;animation:fadeIn .35s ease;}
  .screen.active{display:flex;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

  .brandbar{
    background:linear-gradient(135deg, var(--red) 0%, var(--red-dark) 55%, var(--red-deep) 100%);
    color:var(--white);
    padding:18px 22px 22px;
    position:relative;
    overflow:hidden;
  }
  .brandbar::after{
    content:"";
    position:absolute; right:-40px; top:-40px; width:160px; height:160px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(212,175,55,0.35), transparent 70%);
  }
  .brandbar .logo-row{display:flex;align-items:center;gap:10px;position:relative;z-index:1;}
  .brandbar .logo-mark{
    width:34px;height:34px;border-radius:9px;
    background:linear-gradient(135deg, var(--gold-light), var(--gold));
    display:flex;align-items:center;justify-content:center;
    font-weight:900;color:var(--red-deep);font-size:16px;font-family:'Poppins',sans-serif;
    box-shadow:var(--shadow-sm);
  }
  .brandbar .brandname{font-size:13px;letter-spacing:.06em;font-weight:700;opacity:.92;text-transform:uppercase;}
  .brandbar .brandname small{display:block;font-weight:400;font-size:10.5px;opacity:.75;letter-spacing:.04em;}

  /* ---------- landing ---------- */
  .hero{
    padding:34px 26px 30px;
    text-align:center;
    position:relative;
    z-index:1;
  }
  .hero .eyebrow{
    display:inline-block;
    font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--gold-light);
    background:rgba(255,255,255,0.12);
    padding:5px 12px;border-radius:100px;
    margin-bottom:14px;
    border:1px solid rgba(243,215,124,0.4);
  }
  .hero h1{
    font-size:clamp(30px,8vw,40px);
    font-weight:900;
    line-height:1.05;
    margin:0 0 8px;
    letter-spacing:-0.01em;
  }
  .hero h1 span{color:var(--gold-light);}
  .hero p.sub{
    font-size:14.5px;
    opacity:.88;
    max-width:340px;
    margin:0 auto 26px;
    line-height:1.55;
  }
  .egg-stage{
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 8px;
    position:relative;
    height:190px;
  }
  .egg-shadow{
    position:absolute;bottom:6px;left:50%;transform:translateX(-50%);
    width:120px;height:18px;border-radius:50%;
    background:radial-gradient(ellipse, rgba(0,0,0,0.28), transparent 70%);
  }
  .landing-cta{
    margin-top:20px;
  }
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    border:none;border-radius:100px;
    padding:16px 30px;
    font-size:15.5px;font-weight:700;
    transition:transform .15s ease, box-shadow .15s ease, filter .15s ease;
    width:100%;
  }
  .btn-primary{
    background:linear-gradient(135deg, var(--gold-light), var(--gold));
    color:var(--red-deep);
    box-shadow:0 10px 24px rgba(0,0,0,0.22);
  }
  .btn-primary:active{transform:scale(.97);}
  .btn-primary:hover{filter:brightness(1.04);}
  .btn-ghost{
    background:transparent;
    border:1.5px solid rgba(255,255,255,0.55);
    color:var(--white);
  }
  .btn-outline-red{
    background:transparent;border:1.5px solid var(--red);color:var(--red);
  }
  .btn-secondary{
    background:var(--gold-soft);color:var(--red-deep);
  }
  .btn:disabled{opacity:.5;cursor:not-allowed;filter:grayscale(.3);}
  .btn-sm{padding:9px 16px;font-size:13px;width:auto;}
  .btn-block{width:100%;}

  .admin-link{
    text-align:center;padding:14px;font-size:12px;color:var(--ink-soft);
  }
  .admin-link a{color:var(--ink-soft);text-decoration:underline;cursor:pointer;}

  /* ---------- form ---------- */
  .body-pad{padding:26px 24px 30px;flex:1;}
  .step-label{font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:6px;}
  .screen-title{font-size:22px;font-weight:800;margin:0 0 6px;color:var(--ink);}
  .screen-desc{font-size:13.5px;color:var(--ink-soft);margin:0 0 22px;line-height:1.5;}

  .field{margin-bottom:16px;}
  .field label{display:block;font-size:13px;font-weight:600;margin-bottom:6px;color:var(--ink);}
  .field label .req{color:var(--red);}
  .field label .opt{color:var(--ink-soft);font-weight:400;font-size:11.5px;}
  .field input, .field select, .field textarea{
    width:100%;padding:13px 14px;border-radius:12px;
    border:1.5px solid #EBD9C8;
    background:var(--white);
    font-size:14.5px;color:var(--ink);
    outline:none;
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    border-color:var(--red);
    box-shadow:0 0 0 3px rgba(200,16,46,0.12);
  }
  .field .hint{font-size:11.5px;color:var(--ink-soft);margin-top:5px;}
  .field .err{font-size:11.5px;color:var(--danger);margin-top:5px;display:none;font-weight:600;}
  .field.has-error input, .field.has-error select{border-color:var(--danger);}
  .field.has-error .err{display:block;}

  .alert{
    border-radius:12px;padding:12px 14px;font-size:13px;margin-bottom:16px;line-height:1.5;
  }
  .alert-warn{background:#FFF3E0;color:var(--warn);border:1px solid #F6D9A6;}
  .alert-danger{background:#FDEAEC;color:var(--danger);border:1px solid #F5C0C8;}
  .alert-info{background:var(--gold-soft);color:var(--red-dark);border:1px solid #ECD9A0;}

  /* ---------- game screen ---------- */
  .game-wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px 24px 34px;text-align:center;}
  .game-hello{font-size:13px;color:var(--ink-soft);margin-bottom:2px;}
  .game-hello b{color:var(--ink);}
  .game-title{font-size:20px;font-weight:800;margin:2px 0 26px;}
  .egg-arena{position:relative;height:260px;width:260px;display:flex;align-items:center;justify-content:center;margin-bottom:8px;}
  .egg-svg-wrap{position:relative;width:180px;height:220px;transform-origin:50% 80%;}
  .egg-svg-wrap.shaking{animation:eggShake .5s ease-in-out infinite;}
  @keyframes eggShake{
    0%,100%{transform:rotate(0deg) translateX(0);}
    20%{transform:rotate(-6deg) translateX(-4px);}
    40%{transform:rotate(5deg) translateX(4px);}
    60%{transform:rotate(-4deg) translateX(-3px);}
    80%{transform:rotate(4deg) translateX(3px);}
  }
  .egg-svg-wrap.cracking .egg-top{animation:crackTop .55s ease-in forwards;}
  .egg-svg-wrap.cracking .egg-bottom{animation:crackBottom .55s ease-in forwards;}
  .egg-svg-wrap.cracking .egg-whole{opacity:0;transition:opacity .1s;}
  @keyframes crackTop{
    0%{transform:translateY(0) rotate(0deg);opacity:1;}
    100%{transform:translateY(-90px) rotate(-18deg) translateX(-30px);opacity:0;}
  }
  @keyframes crackBottom{
    0%{transform:translateY(0) rotate(0deg);opacity:1;}
    100%{transform:translateY(90px) rotate(14deg) translateX(24px);opacity:0;}
  }
  .crack-line{opacity:0;}
  .egg-svg-wrap.shaking .crack-line{opacity:0;}
  .spark{position:absolute;pointer-events:none;opacity:0;}
  .egg-svg-wrap.cracking .spark{animation:sparkPop .6s ease-out forwards;}
  @keyframes sparkPop{
    0%{opacity:1;transform:scale(0.3) translateY(0);}
    100%{opacity:0;transform:scale(1.3) translateY(-40px);}
  }
  .break-btn{
    margin-top:14px;
    max-width:280px;
  }
  .game-note{font-size:11.5px;color:var(--ink-soft);margin-top:16px;max-width:280px;line-height:1.5;}
  .confetti-piece{position:fixed;top:-10px;width:8px;height:14px;opacity:.95;z-index:50;pointer-events:none;}

  /* ---------- result screen ---------- */
  .result-wrap{flex:1;padding:0 0 30px;display:flex;flex-direction:column;}
  .result-hero{
    background:linear-gradient(160deg, var(--red) 0%, var(--red-dark) 60%, var(--red-deep) 100%);
    color:var(--white);
    padding:30px 24px 60px;
    text-align:center;
    position:relative;
  }
  .result-hero h2{font-size:26px;font-weight:900;margin:8px 0 4px;}
  .result-hero .sub{font-size:13px;opacity:.85;}
  .reward-card{
    background:var(--white);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    margin:-42px 22px 0;
    padding:24px 22px;
    position:relative;
    text-align:center;
    border:1px solid #F1E2C9;
  }
  .reward-icon{
    width:88px;height:88px;border-radius:22px;
    margin:0 auto 14px;
    background:linear-gradient(135deg, var(--gold-light), var(--gold));
    display:flex;align-items:center;justify-content:center;
    font-size:40px;
    box-shadow:var(--shadow-sm);
  }
  .reward-name{font-size:19px;font-weight:800;color:var(--ink);margin:0 0 2px;}
  .reward-desc{font-size:12.5px;color:var(--ink-soft);margin-bottom:18px;}
  .divider-dash{border-top:1.5px dashed #E7D3B8;margin:16px 0;position:relative;}
  .divider-dash::before, .divider-dash::after{
    content:"";position:absolute;top:-9px;width:18px;height:18px;border-radius:50%;background:var(--cream);
  }
  .divider-dash::before{left:-40px;}
  .divider-dash::after{right:-40px;}
  .info-grid{text-align:left;display:grid;grid-template-columns:1fr 1fr;gap:10px 14px;font-size:13px;margin-bottom:6px;}
  .info-grid .lbl{color:var(--ink-soft);font-size:11px;text-transform:uppercase;letter-spacing:.05em;}
  .info-grid .val{font-weight:600;color:var(--ink);}
  .winner-code-box{
    margin-top:16px;background:var(--gold-soft);border:1.5px dashed var(--gold);
    border-radius:14px;padding:14px;text-align:center;
  }
  .winner-code-box .lbl{font-size:10.5px;font-weight:700;letter-spacing:.1em;color:var(--red-dark);text-transform:uppercase;}
  .winner-code-box .code{font-family:'Poppins',sans-serif;font-size:22px;font-weight:800;color:var(--red-deep);letter-spacing:.03em;margin-top:4px;}
  .result-actions{padding:22px 22px 0;}
  .instr-box{margin:16px 22px 0;font-size:12px;color:var(--ink-soft);background:#FBF6EC;border-radius:12px;padding:12px 14px;line-height:1.55;}

  /* ---------- admin ---------- */
  .admin-body{padding:30px 26px;flex:1;}
  .admin-header{padding:20px 24px;background:var(--ink);color:var(--white);display:flex;align-items:center;justify-content:space-between;}
  .admin-header .t{font-weight:800;font-size:15px;}
  .admin-tabs{display:flex;gap:6px;padding:12px 16px 0;overflow-x:auto;background:var(--white);border-bottom:1px solid #F0E2CC;position:sticky;top:0;z-index:5;}
  .admin-tab{
    padding:10px 14px;font-size:12.5px;font-weight:700;color:var(--ink-soft);
    border-bottom:2.5px solid transparent;white-space:nowrap;cursor:pointer;
  }
  .admin-tab.active{color:var(--red);border-color:var(--red);}
  .admin-panel{display:none;padding:20px;}
  .admin-panel.active{display:block;}

  .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px;}
  .stat-card{background:var(--white);border:1px solid #F0E2CC;border-radius:14px;padding:14px;box-shadow:var(--shadow-sm);}
  .stat-card .n{font-size:22px;font-weight:800;color:var(--red);font-family:'Poppins',sans-serif;}
  .stat-card .l{font-size:11px;color:var(--ink-soft);margin-top:2px;}

  .section-title{font-size:14px;font-weight:800;margin:22px 0 10px;color:var(--ink);}
  .card{background:var(--white);border:1px solid #F0E2CC;border-radius:14px;padding:14px;margin-bottom:10px;box-shadow:var(--shadow-sm);}
  .reward-row{display:flex;gap:12px;align-items:center;}
  .reward-row .thumb{width:44px;height:44px;border-radius:10px;background:var(--gold-soft);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;overflow:hidden;}
  .reward-row .thumb img{width:100%;height:100%;object-fit:cover;}
  .reward-row .meta{flex:1;min-width:0;}
  .reward-row .meta .nm{font-weight:700;font-size:13.5px;}
  .reward-row .meta .sub{font-size:11.5px;color:var(--ink-soft);margin-top:2px;}
  .pill{display:inline-block;font-size:10.5px;font-weight:700;padding:3px 9px;border-radius:100px;}
  .pill-active{background:#E4F6EA;color:var(--ok);}
  .pill-inactive{background:#F1E5E5;color:#9A5A5A;}
  .pill-unclaimed{background:#FFF3E0;color:var(--warn);}
  .pill-claimed{background:#E4F6EA;color:var(--ok);}
  .row-actions{display:flex;gap:8px;margin-top:10px;}

  table.records{width:100%;border-collapse:collapse;font-size:12px;}
  table.records th{text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);padding:8px 6px;border-bottom:1.5px solid #F0E2CC;white-space:nowrap;}
  table.records td{padding:9px 6px;border-bottom:1px solid #F5EBDA;white-space:nowrap;}
  .table-scroll{overflow-x:auto;border:1px solid #F0E2CC;border-radius:12px;margin-top:10px;}

  .toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:4px;}
  .toolbar input, .toolbar select{flex:1;min-width:120px;padding:10px 12px;border-radius:10px;border:1.5px solid #EBD9C8;font-size:12.5px;}

  .modal-backdrop{position:fixed;inset:0;background:rgba(42,16,19,0.55);display:none;align-items:center;justify-content:center;z-index:100;padding:20px;}
  .modal-backdrop.active{display:flex;}
  .modal{background:var(--white);border-radius:16px;padding:22px;max-width:380px;width:100%;box-shadow:var(--shadow);}
  .modal h3{margin:0 0 6px;font-size:16px;}
  .modal p{font-size:12.5px;color:var(--ink-soft);margin:0 0 14px;line-height:1.5;}
  .modal .field{margin-bottom:12px;}
  .modal-actions{display:flex;gap:10px;margin-top:6px;}

  .toast{
    position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
    background:var(--ink);color:var(--white);padding:12px 20px;border-radius:100px;
    font-size:12.5px;font-weight:600;box-shadow:var(--shadow);z-index:200;
    opacity:0;transition:opacity .25s ease, transform .25s ease;pointer-events:none;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(-6px);}

  .back-row{display:flex;align-items:center;gap:8px;margin-bottom:4px;}
  .icon-btn{background:none;border:none;font-size:18px;color:var(--ink-soft);padding:4px;}

  .switch{position:relative;display:inline-block;width:38px;height:22px;flex-shrink:0;}
  .switch input{opacity:0;width:0;height:0;}
  .slider-tog{position:absolute;cursor:pointer;inset:0;background-color:#DCC9AE;transition:.2s;border-radius:100px;}
  .slider-tog:before{position:absolute;content:"";height:16px;width:16px;left:3px;bottom:3px;background:white;transition:.2s;border-radius:50%;}
  input:checked + .slider-tog{background-color:var(--ok);}
  input:checked + .slider-tog:before{transform:translateX(16px);}

  .footer-note{text-align:center;font-size:10.5px;color:#C9AFAF;padding:16px;}

  @media (min-width:540px){
    body{background-attachment:fixed;}
    #app{margin-top:0;min-height:100vh;}
  }
</style>
</head>
<body>

<div id="app">

  <!-- ================= LANDING ================= -->
  <section class="screen active" id="screen-landing">
    <div class="batik-strip top"></div>
    <div class="brandbar">
      <div class="logo-row">
        <div class="logo-mark">S</div>
        <div class="brandname">Sinarmas Multifinance<small>Program Marketing &amp; Dealer</small></div>
      </div>
      <div class="hero">
        <span class="eyebrow">Program Berhadiah</span>
        <h1>Pecah <span>Telur</span><br>Menangkan Hadiahnya</h1>
        <p class="sub">Isi datamu, pecahkan satu telur virtual, dan lihat hadiah kejutan yang kamu menangkan hari ini.</p>
        <div class="egg-stage">
          <div class="egg-shadow"></div>
          <svg width="150" height="180" viewBox="0 0 150 180" fill="none">
            <defs>
              <linearGradient id="eggGradLand" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#FBEFC7"/>
                <stop offset="55%" stop-color="#F3D77C"/>
                <stop offset="100%" stop-color="#D4AF37"/>
              </linearGradient>
            </defs>
            <path d="M75 6C110 6 138 66 138 112C138 150 110 174 75 174C40 174 12 150 12 112C12 66 40 6 75 6Z" fill="url(#eggGradLand)" stroke="#7A0C1E" stroke-width="2.5"/>
            <path d="M40 60 L58 60 L48 82 L64 82 L44 118" stroke="#C8102E" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/>
            <circle cx="100" cy="55" r="4" fill="#C8102E" opacity="0.55"/>
            <circle cx="108" cy="90" r="3" fill="#C8102E" opacity="0.45"/>
            <circle cx="94" cy="120" r="3.5" fill="#C8102E" opacity="0.5"/>
          </svg>
        </div>
        <div class="landing-cta">
          <button class="btn btn-primary" id="btn-start">🥚 Mulai Main</button>
        </div>
      </div>
    </div>
    <div class="body-pad" style="padding-top:20px;">
      <div class="alert alert-info" id="landing-period-note" style="display:none;"></div>
      <div style="display:flex;gap:10px;">
        <div style="flex:1;text-align:center;padding:14px 8px;background:var(--gold-soft);border-radius:14px;">
          <div style="font-size:20px;">📝</div>
          <div style="font-size:11px;color:var(--ink-soft);margin-top:4px;font-weight:600;">Isi Data</div>
        </div>
        <div style="flex:1;text-align:center;padding:14px 8px;background:var(--gold-soft);border-radius:14px;">
          <div style="font-size:20px;">🥚</div>
          <div style="font-size:11px;color:var(--ink-soft);margin-top:4px;font-weight:600;">Pecahkan Telur</div>
        </div>
        <div style="flex:1;text-align:center;padding:14px 8px;background:var(--gold-soft);border-radius:14px;">
          <div style="font-size:20px;">🎁</div>
          <div style="font-size:11px;color:var(--ink-soft);margin-top:4px;font-weight:600;">Menang Hadiah</div>
        </div>
      </div>
    </div>
    <div style="flex:1;"></div>
    <div class="admin-link">Panitia / PIC program? <a id="link-admin">Masuk sebagai Admin</a></div>
    <div class="batik-strip bottom"></div>
  </section>

  <!-- ================= FORM PESERTA ================= -->
  <section class="screen" id="screen-form">
    <div class="brandbar" style="padding:16px 22px;">
      <div class="back-row">
        <button class="icon-btn" id="btn-back-form">←</button>
        <div class="logo-row"><div class="logo-mark" style="width:26px;height:26px;font-size:13px;">S</div><div class="brandname" style="font-size:11.5px;">Sinarmas Multifinance</div></div>
      </div>
    </div>
    <div class="body-pad">
