<script>
(function(){
"use strict";

/* =========================================================
   STORAGE LAYER
   Menggunakan window.storage (shared=true) sebagai simulasi
   "backend" bersama, agar stok & winner code tetap konsisten
   lintas sesi/perangkat selama demo ini berjalan.
   ========================================================= */
const KEYS = { REWARDS:'pt_rewards', RECORDS:'pt_records', SETTINGS:'pt_settings' };

const DEFAULT_REWARDS = [
  {id:'r1', name:'Voucher Rp500.000', icon:'💳', image:'', desc:'Voucher belanja senilai Rp500.000', stock:2, weight:1, active:true},
  {id:'r2', name:'Voucher Rp100.000', icon:'💵', image:'', desc:'Voucher belanja senilai Rp100.000', stock:10, weight:5, active:true},
  {id:'r3', name:'Merchandise', icon:'🎽', image:'', desc:'Merchandise eksklusif Sinarmas Multifinance', stock:30, weight:15, active:true},
  {id:'r4', name:'Voucher Rp50.000', icon:'🎫', image:'', desc:'Voucher belanja senilai Rp50.000', stock:50, weight:30, active:true},
  {id:'r5', name:'Hadiah Hiburan', icon:'🎉', image:'', desc:'Hadiah hiburan menarik', stock:100, weight:49, active:true},
];
const DEFAULT_SETTINGS = {
  programName:'Pecah Telur', periodStart:'', periodEnd:'', active:true,
  maxPlay:1, disclaimer:'Hadiah tidak dapat diuangkan dan tunduk pada syarat & ketentuan program.',
  adminPassword:'admin123'
};

async function storGet(key, fallback){
  try{
    const res = await window.storage.get(key, true);
    if(res && res.value !== undefined) return JSON.parse(res.value);
    return fallback;
  }catch(e){ return fallback; }
}
async function storSet(key, value){
  try{ await window.storage.set(key, JSON.stringify(value), true); }catch(e){ console.error('storage set failed', e); }
}

let rewards = [];
let records = [];
let settings = {...DEFAULT_SETTINGS};

async function loadAll(){
  rewards = await storGet(KEYS.REWARDS, null);
  if(!rewards){ rewards = DEFAULT_REWARDS.map(r=>({...r})); await storSet(KEYS.REWARDS, rewards); }
  records = await storGet(KEYS.RECORDS, null);
  if(!records){ records = []; await storSet(KEYS.RECORDS, records); }
  settings = await storGet(KEYS.SETTINGS, null);
  if(!settings){ settings = {...DEFAULT_SETTINGS}; await storSet(KEYS.SETTINGS, settings); }
}

/* =========================================================
   UTIL
   ========================================================= */
function $(sel){ return document.querySelector(sel); }
function $all(sel){ return Array.from(document.querySelectorAll(sel)); }
function showScreen(id){
  $all('.screen').forEach(s=>s.classList.remove('active'));
  $('#'+id).classList.add('active');
  window.scrollTo(0,0);
}
function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toast._tm); toast._tm = setTimeout(()=>t.classList.remove('show'), 2400);
}
function fmtDate(d){
  const dt = new Date(d);
  return dt.toLocaleString('id-ID', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
}
function pad(n,len){ return String(n).padStart(len,'0'); }

function secureRandomInt(maxExclusive){
  const arr = new Uint32Array(1);
  crypto.getRandomValues(arr);
  return arr[0] % maxExclusive;
}

function weightedPick(activeRewards){
  const totalWeight = activeRewards.reduce((s,r)=>s+Number(r.weight||0),0);
  if(totalWeight<=0) return null;
  let roll = secureRandomInt(totalWeight);
  for(const r of activeRewards){
    const w = Number(r.weight||0);
    if(roll < w) return r;
    roll -= w;
  }
  return activeRewards[activeRewards.length-1];
}

function genWinnerCode(existingCodes){
  const now = new Date();
  const ymd = pad(now.getFullYear()%100,2)+pad(now.getMonth()+1,2)+pad(now.getDate(),2);
  let code, tries=0;
  do{
    const num = secureRandomInt(100000);
    code = 'PET-'+ymd+'-'+pad(num,5);
    tries++;
  }while(existingCodes.has(code) && tries<50);
  return code;
}

/* =========================================================
   ELIGIBILITY / ANTI-CHEAT (client-side approximation)
   ========================================================= */
function findPriorPlays(nama, dealer, cabang, hp){
  const normHp = (hp||'').replace(/\D/g,'');
  return records.filter(rec=>{
    if(normHp && rec.hp && rec.hp.replace(/\D/g,'')===normHp) return true;
    if(!normHp){
      return rec.nama.trim().toLowerCase()===nama.trim().toLowerCase() &&
             rec.dealer.trim().toLowerCase()===dealer.trim().toLowerCase() &&
             rec.cabang.trim().toLowerCase()===cabang.trim().toLowerCase();
    }
    return false;
  });
}

/* =========================================================
   STATE (current participant in flow)
   ========================================================= */
let currentParticipant = null;
let currentReward = null;
let currentWinnerCode = null;

/* =========================================================
   LANDING
   ========================================================= */
function renderLandingInfo(){
  const note = $('#landing-period-note');
  if(!settings.active){
    note.style.display='block';
    note.textContent = 'Program sedang tidak aktif saat ini. Silakan hubungi panitia untuk informasi lebih lanjut.';
    $('#btn-start').disabled = true;
  } else if(settings.periodStart && settings.periodEnd){
    note.style.display='block';
    note.textContent = 'Periode program: '+settings.periodStart+' s/d '+settings.periodEnd;
    $('#btn-start').disabled = false;
  } else {
    note.style.display='none';
    $('#btn-start').disabled = false;
  }
}

$('#btn-start').addEventListener('click', ()=>{
  $('#form-alert').style.display='none';
  showScreen('screen-form');
});
$('#btn-back-form').addEventListener('click', ()=> showScreen('screen-landing'));
$('#link-admin').addEventListener('click', ()=> showScreen('screen-admin-login'));
$('#btn-back-adminlogin').addEventListener('click', ()=> showScreen('screen-landing'));

/* =========================================================
   FORM PESERTA
   ========================================================= */
function clearFormErrors(){
  ['f-nama','f-dealer','f-cabang'].forEach(id=> $('#'+id).classList.remove('has-error'));
  $('#form-alert').style.display='none';
}

$('#btn-submit-form').addEventListener('click', async ()=>{
  clearFormErrors();
  const nama = $('#input-nama').value.trim();
  const dealer = $('#input-dealer').value.trim();
  const cabang = $('#input-cabang').value.trim();
  const hp = $('#input-hp').value.trim();
  const promo = $('#input-promo').value.trim();

  let valid = true;
  if(!nama){ $('#f-nama').classList.add('has-error'); valid=false; }
  if(!dealer){ $('#f-dealer').classList.add('has-error'); valid=false; }
  if(!cabang){ $('#f-cabang').classList.add('has-error'); valid=false; }
  if(!valid) return;

  // refresh data terbaru sebelum cek eligibility
  records = await storGet(KEYS.RECORDS, records);
  settings = await storGet(KEYS.SETTINGS, settings);

  if(!settings.active){
    $('#form-alert').style.display='block';
    $('#form-alert').textContent = 'Mohon maaf, program sedang tidak aktif.';
    return;
  }

  const priorPlays = findPriorPlays(nama, dealer, cabang, hp);
  const maxPlay = Number(settings.maxPlay||1);
  if(priorPlays.length >= maxPlay){
    $('#form-alert').style.display='block';
    $('#form-alert').textContent = 'Kamu sudah mencapai batas maksimal bermain ('+maxPlay+'x) pada program ini.';
    return;
  }

  currentParticipant = {nama, dealer, cabang, hp, promo};
  $('#game-nama-peserta').textContent = nama;
  resetEggVisual();
  showScreen('screen-game');
});

/* =========================================================
   GAME SCREEN
   ========================================================= */
function resetEggVisual(){
  const wrap = $('#egg-svg-wrap');
  wrap.classList.remove('shaking','cracking');
  $('#btn-break').disabled = false;
  $('#btn-break').textContent = 'Pecahkan Telur!';
}

$('#btn-break').addEventListener('click', async ()=>{
  const btn = $('#btn-break');
  const wrap = $('#egg-svg-wrap');
  btn.disabled = true;
  btn.textContent = 'Memproses...';

  // refresh rewards terbaru & tentukan hadiah SEBELUM animasi selesai
  rewards = await storGet(KEYS.REWARDS, rewards);
  const activeRewards = rewards.filter(r=> r.active && Number(r.stock)>0);
  if(activeRewards.length===0){
    toast('Maaf, stok hadiah sedang habis. Hubungi panitia.');
    btn.disabled = false;
    btn.textContent = 'Pecahkan Telur!';
    return;
  }
  const picked = weightedPick(activeRewards);
  currentReward = picked;

  wrap.classList.add('shaking');
  setTimeout(async ()=>{
    wrap.classList.remove('shaking');
    wrap.classList.add('cracking');
    fireConfetti();

    // decrement stock secara atomik-terbaik: baca ulang, kurangi, simpan
    rewards = await storGet(KEYS.REWARDS, rewards);
    const idx = rewards.findIndex(r=>r.id===picked.id);
    if(idx>-1 && rewards[idx].stock>0){ rewards[idx].stock -= 1; await storSet(KEYS.REWARDS, rewards); }

    // generate winner code unik
    records = await storGet(KEYS.RECORDS, records);
    const existingCodes = new Set(records.map(r=>r.code));
    currentWinnerCode = genWinnerCode(existingCodes);

    const rec = {
      id: 'p_'+Date.now()+'_'+secureRandomInt(9999),
      timestamp: new Date().toISOString(),
      nama: currentParticipant.nama,
      dealer: currentParticipant.dealer,
      cabang: currentParticipant.cabang,
      hp: currentParticipant.hp,
      promo: currentParticipant.promo,
      rewardId: picked.id,
      rewardName: picked.name,
      code: currentWinnerCode,
      status: 'UNCLAIMED',
      claimTime: '',
      claimPic: ''
    };
    records.push(rec);
    await storSet(KEYS.RECORDS, records);

    setTimeout(()=>{ renderResult(rec, picked); showScreen('screen-result'); }, 700);
  }, 1250);
});

function fireConfetti(){
  const colors = ['#C8102E','#D4AF37','#F3D77C','#7A0C1E','#FFFFFF'];
  for(let i=0;i<26;i++){
    const el = document.createElement('div');
    el.className = 'confetti-piece';
    el.style.left = (10+Math.random()*80)+'vw';
    el.style.background = colors[i%colors.length];
    el.style.borderRadius = Math.random()>0.5 ? '50%':'2px';
    el.style.transform = 'rotate('+Math.floor(Math.random()*360)+'deg)';
    const duration = 1400+Math.random()*900;
    el.style.transition = 'transform '+duration+'ms ease-in, top '+duration+'ms ease-in, opacity '+duration+'ms ease-in';
    document.body.appendChild(el);
    requestAnimationFrame(()=>{
      el.style.top = (90+Math.random()*10)+'vh';
      el.style.transform += ' translateX('+(Math.random()*80-40)+'px)';
      el.style.opacity = '0.15';
    });
    setTimeout(()=> el.remove(), duration+200);
  }
}

/* =========================================================
   RESULT SCREEN
   ========================================================= */
function renderResult(rec, reward){
  $('#result-reward-icon').textContent = reward.icon || '🎁';
  if(reward.image){
    $('#result-reward-icon').innerHTML = '<img src="'+reward.image+'" style="width:100%;height:100%;object-fit:cover;border-radius:22px;" alt="">';
  }
  $('#result-reward-name').textContent = reward.name;
  $('#result-reward-desc').textContent = reward.desc || '';
  $('#result-nama').textContent = rec.nama;
  $('#result-dealer').textContent = rec.dealer;
  $('#result-cabang').textContent = rec.cabang;
  $('#result-tanggal').textContent = fmtDate(rec.timestamp);
  $('#result-code').textContent = rec.code;
}
$('#btn-result-home').addEventListener('click', ()=>{
  $('#input-nama').value=''; $('#input-dealer').value=''; $('#input-cabang').value='';
  $('#input-hp').value=''; $('#input-promo').value='';
  showScreen('screen-landing');
});

/* =========================================================
   ADMIN LOGIN
   ========================================================= */
$('#btn-admin-login').addEventListener('click', async ()=>{
  settings = await storGet(KEYS.SETTINGS, settings);
  const val = $('#input-admin-pass').value;
  if(val === settings.adminPassword){
    $('#admin-login-alert').style.display='none';
    $('#input-admin-pass').value='';
    await enterAdmin();
  }else{
    $('#admin-login-alert').style.display='block';
  }
});
$('#btn-admin-logout').addEventListener('click', ()=> showScreen('screen-landing'));

async function enterAdmin(){
  rewards = await storGet(KEYS.REWARDS, rewards);
  records = await storGet(KEYS.RECORDS, records);
  settings = await storGet(KEYS.SETTINGS, settings);
  renderOverview();
  renderRewardsList();
  renderRecordsTable();
  fillSettingsForm();
  showScreen('screen-admin');
}

/* =========================================================
   ADMIN TABS
   ========================================================= */
$all('.admin-tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    $all('.admin-tab').forEach(t=>t.classList.remove('active'));
    $all('.admin-panel').forEach(p=>p.classList.remove('active'));
    tab.classList.add('active');
    $('#panel-'+tab.dataset.tab).classList.add('active');
  });
});

/* =========================================================
   ADMIN — OVERVIEW
   ========================================================= */
function renderOverview(){
  const totalPlays = records.length;
  const uniqueParticipants = new Set(records.map(r=> (r.hp && r.hp.replace(/\D/g,'')) || (r.nama+'|'+r.dealer+'|'+r.cabang).toLowerCase())).size;
  const totalWinners = records.length; // setiap play valid = 1 reward
  const claimed = records.filter(r=>r.status==='CLAIMED').length;
  const unclaimed = records.filter(r=>r.status==='UNCLAIMED').length;

  $('#st-participants').textContent = uniqueParticipants;
  $('#st-plays').textContent = totalPlays;
  $('#st-winners').textContent = totalWinners;
  $('#st-rewards-out').textContent = totalPlays;
  $('#st-claimed').textContent = claimed;
  $('#st-unclaimed').textContent = unclaimed;

  const stockWrap = $('#overview-stock-list');
  stockWrap.innerHTML = rewards.map(r=>`
    <div class="card" style="display:flex;align-items:center;justify-content:space-between;">
      <div class="reward-row"><div class="thumb">${r.image?('<img src="'+r.image+'">'):(r.icon||'🎁')}</div>
        <div class="meta"><div class="nm">${escapeHtml(r.name)}</div><div class="sub">Weight ${r.weight} · ${r.active?'Aktif':'Nonaktif'}</div></div>
      </div>
      <div style="text-align:right;"><div style="font-weight:800;font-size:16px;color:var(--red);">${r.stock}</div><div style="font-size:10px;color:var(--ink-soft);">sisa stok</div></div>
    </div>`).join('') || '<p style="font-size:12.5px;color:var(--ink-soft);">Belum ada hadiah.</p>';

  const byDealer = groupCount(records, 'dealer');
  $('#tbl-by-dealer tbody').innerHTML = Object.entries(byDealer).map(([k,v])=>
    `<tr><td>${escapeHtml(k)}</td><td>${v}</td><td>${v}</td></tr>`).join('') || '<tr><td colspan="3" style="color:var(--ink-soft);">Belum ada data</td></tr>';

  const byCabang = groupCount(records, 'cabang');
  $('#tbl-by-cabang tbody').innerHTML = Object.entries(byCabang).map(([k,v])=>
    `<tr><td>${escapeHtml(k)}</td><td>${v}</td><td>${v}</td></tr>`).join('') || '<tr><td colspan="3" style="color:var(--ink-soft);">Belum ada data</td></tr>';
}
function groupCount(list, field){
  const out = {};
  list.forEach(r=>{ const k=r[field]||'-'; out[k]=(out[k]||0)+1; });
  return out;
}
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

/* =========================================================
   ADMIN — REWARDS CRUD
   ========================================================= */
function renderRewardsList(){
  const wrap = $('#rewards-list');
  wrap.innerHTML = rewards.map(r=>`
    <div class="card">
      <div class="reward-row">
        <div class="thumb">${r.image?('<img src="'+r.image+'">'):(r.icon||'🎁')}</div>
        <div class="meta">
          <div class="nm">${escapeHtml(r.name)} <span class="pill ${r.active?'pill-active':'pill-inactive'}">${r.active?'Aktif':'Nonaktif'}</span></div>
          <div class="sub">Stok: ${r.stock} · Weight: ${r.weight}</div>
        </div>
      </div>
      <div class="row-actions">
        <button class="btn btn-secondary btn-sm" data-edit="${r.id}">Edit</button>
        <button class="btn btn-outline-red btn-sm" data-toggle="${r.id}">${r.active?'Nonaktifkan':'Aktifkan'}</button>
        <button class="btn btn-outline-red btn-sm" data-del="${r.id}">Hapus</button>
      </div>
    </div>`).join('') || '<p style="font-size:12.5px;color:var(--ink-soft);">Belum ada hadiah. Tambahkan hadiah baru.</p>';

  wrap.querySelectorAll('[data-edit]').forEach(b=> b.addEventListener('click', ()=> openRewardModal(b.dataset.edit)));
  wrap.querySelectorAll('[data-toggle]').forEach(b=> b.addEventListener('click', ()=> toggleReward(b.dataset.toggle)));
  wrap.querySelectorAll('[data-del]').forEach(b=> b.addEventListener('click', ()=> deleteReward(b.dataset.del)));
}

$('#btn-add-reward').addEventListener('click', ()=> openRewardModal(null));
$('#btn-cancel-reward').addEventListener('click', ()=> $('#modal-reward').classList.remove('active'));

function openRewardModal(id){
  const r = id ? rewards.find(x=>x.id===id) : null;
  $('#modal-reward-title').textContent = r ? 'Edit Hadiah' : 'Tambah Hadiah';
  $('#rw-id').value = r ? r.id : '';
  $('#rw-name').value = r ? r.name : '';
  $('#rw-icon').value = r ? (r.icon||'🎁') : '🎁';
  $('#rw-image').value = r ? (r.image||'') : '';
  $('#rw-desc').value = r ? (r.desc||'') : '';
  $('#rw-stock').value = r ? r.stock : 10;
  $('#rw-weight').value = r ? r.weight : 10;
  $('#rw-active').checked = r ? !!r.active : true;
  $('#modal-reward').classList.add('active');
}

$('#btn-save-reward').addEventListener('click', async ()=>{
  const id = $('#rw-id').value;
  const name = $('#rw-name').value.trim();
  if(!name){ toast('Nama hadiah wajib diisi'); return; }
  const data = {
    name,
    icon: $('#rw-icon').value.trim() || '🎁',
    image: $('#rw-image').value.trim(),
    desc: $('#rw-desc').value.trim(),
    stock: Math.max(0, parseInt($('#rw-stock').value)||0),
    weight: Math.max(1, parseInt($('#rw-weight').value)||1),
    active: $('#rw-active').checked
  };
  rewards = await storGet(KEYS.REWARDS, rewards);
  if(id){
    const idx = rewards.findIndex(r=>r.id===id);
    if(idx>-1) rewards[idx] = {...rewards[idx], ...data};
  }else{
    data.id = 'r_'+Date.now();
    rewards.push(data);
  }
  await storSet(KEYS.REWARDS, rewards);
  $('#modal-reward').classList.remove('active');
  renderRewardsList(); renderOverview();
  toast('Hadiah disimpan');
});

async function toggleReward(id){
  rewards = await storGet(KEYS.REWARDS, rewards);
  const idx = rewards.findIndex(r=>r.id===id);
  if(idx>-1){ rewards[idx].active = !rewards[idx].active; await storSet(KEYS.REWARDS, rewards); }
  renderRewardsList(); renderOverview();
}
async function deleteReward(id){
  if(!confirm('Hapus hadiah ini?')) return;
  rewards = await storGet(KEYS.REWARDS, rewards);
  rewards = rewards.filter(r=>r.id!==id);
  await storSet(KEYS.REWARDS, rewards);
  renderRewardsList(); renderOverview();
  toast('Hadiah dihapus');
}

/* =========================================================
   ADMIN — RECORDS / WINNERS
   ========================================================= */
let claimTargetId = null;

function renderRecordsTable(){
  const q = ($('#rec-search').value||'').toLowerCase();
  const statusF = $('#rec-filter-status').value;
  const dateF = $('#rec-filter-date').value;

  let list = [...records].reverse();
  if(q){
    list = list.filter(r=>
      r.nama.toLowerCase().includes(q) || r.dealer.toLowerCase().includes(q) ||
      r.cabang.toLowerCase().includes(q) || r.code.toLowerCase().includes(q) ||
      r.rewardName.toLowerCase().includes(q));
  }
  if(statusF) list = list.filter(r=>r.status===statusF);
  if(dateF) list = list.filter(r=> r.timestamp.slice(0,10)===dateF);

  $('#tbl-records tbody').innerHTML = list.map(r=>`
    <tr>
      <td>${fmtDate(r.timestamp)}</td>
      <td>${escapeHtml(r.nama)}</td>
      <td>${escapeHtml(r.dealer)}</td>
      <td>${escapeHtml(r.cabang)}</td>
      <td>${escapeHtml(r.rewardName)}</td>
      <td><b>${r.code}</b></td>
      <td><span class="pill ${r.status==='CLAIMED'?'pill-claimed':'pill-unclaimed'}">${r.status}</span></td>
      <td>${r.status==='UNCLAIMED' ? `<button class="btn btn-secondary btn-sm" data-claim="${r.id}">Verifikasi</button>` : (r.claimPic? 'oleh '+escapeHtml(r.claimPic):'-')}</td>
    </tr>`).join('') || '<tr><td colspan="8" style="color:var(--ink-soft);">Belum ada data peserta.</td></tr>';

  $all('[data-claim]').forEach(b=> b.addEventListener('click', ()=> openClaimModal(b.dataset.claim)));
}
['rec-search','rec-filter-status','rec-filter-date'].forEach(id=>{
  $('#'+id).addEventListener('input', renderRecordsTable);
  $('#'+id).addEventListener('change', renderRecordsTable);
});

function openClaimModal(id){
  claimTargetId = id;
  const rec = records.find(r=>r.id===id);
  $('#claim-modal-desc').textContent = 'Konfirmasi penukaran hadiah "'+rec.rewardName+'" untuk kode '+rec.code+' atas nama '+rec.nama+'.';
  $('#claim-pic-name').value='';
  $('#modal-claim').classList.add('active');
}
$('#btn-cancel-claim').addEventListener('click', ()=>{ $('#modal-claim').classList.remove('active'); claimTargetId=null; });
$('#btn-confirm-claim').addEventListener('click', async ()=>{
  const pic = $('#claim-pic-name').value.trim();
  if(!pic){ toast('Nama PIC wajib diisi'); return; }
  records = await storGet(KEYS.RECORDS, records);
  const idx = records.findIndex(r=>r.id===claimTargetId);
  if(idx>-1){
    records[idx].status='CLAIMED';
    records[idx].claimTime = new Date().toISOString();
    records[idx].claimPic = pic;
    await storSet(KEYS.RECORDS, records);
  }
  $('#modal-claim').classList.remove('active');
  renderRecordsTable(); renderOverview();
  toast('Hadiah ditandai CLAIMED');
});

$('#btn-verify-code').addEventListener('click', async ()=>{
  const code = $('#verify-code-input').value.trim().toUpperCase();
  records = await storGet(KEYS.RECORDS, records);
  const rec = records.find(r=>r.code.toUpperCase()===code);
  const out = $('#verify-result');
  if(!rec){
    out.innerHTML = '<span style="color:var(--danger);font-weight:700;">INVALID</span> — Kode tidak ditemukan.';
    return;
  }
  out.innerHTML = `<b>${rec.status}</b> — ${escapeHtml(rec.nama)} (${escapeHtml(rec.dealer)}, ${escapeHtml(rec.cabang)}) memenangkan <b>${escapeHtml(rec.rewardName)}</b> pada ${fmtDate(rec.timestamp)}.`
    + (rec.status==='UNCLAIMED' ? ` <button class="btn btn-secondary btn-sm" style="margin-top:8px;" id="verify-claim-now">Verifikasi Sekarang</button>` : '');
  const btnNow = document.getElementById('verify-claim-now');
  if(btnNow) btnNow.addEventListener('click', ()=> openClaimModal(rec.id));
});

$('#btn-export-csv').addEventListener('click', ()=>{
  const headers = ['Timestamp','Nama','Dealer','Cabang','No HP','Kode Promo','Hadiah','Winner Code','Status','Waktu Klaim','PIC Klaim'];
  const rows = records.map(r=>[
    r.timestamp, r.nama, r.dealer, r.cabang, r.hp||'', r.promo||'', r.rewardName, r.code, r.status, r.claimTime||'', r.claimPic||''
  ]);
  const csv = [headers, ...rows].map(row=>
    row.map(cell=> '"'+String(cell).replace(/"/g,'""')+'"').join(',')
  ).join('\n');
  const blob = new Blob(['\uFEFF'+csv], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'pecah-telur-peserta-'+new Date().toISOString().slice(0,10)+'.csv';
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
  toast('CSV diunduh');
});

/* =========================================================
   ADMIN — SETTINGS
   ========================================================= */
function fillSettingsForm(){
  $('#set-program-name').value = settings.programName || '';
  $('#set-period-start').value = settings.periodStart || '';
  $('#set-period-end').value = settings.periodEnd || '';
  $('#set-active').checked = !!settings.active;
  $('#set-maxplay').value = settings.maxPlay || 1;
  $('#set-disclaimer').value = settings.disclaimer || '';
  $('#set-admin-pass').value = '';
}
$('#btn-save-settings').addEventListener('click', async ()=>{
  settings = await storGet(KEYS.SETTINGS, settings);
  settings.programName = $('#set-program-name').value.trim() || 'Pecah Telur';
  settings.periodStart = $('#set-period-start').value;
  settings.periodEnd = $('#set-period-end').value;
  settings.active = $('#set-active').checked;
  settings.maxPlay = Math.max(1, parseInt($('#set-maxplay').value)||1);
  settings.disclaimer = $('#set-disclaimer').value.trim();
  const newPass = $('#set-admin-pass').value.trim();
  if(newPass) settings.adminPassword = newPass;
  await storSet(KEYS.SETTINGS, settings);
  $('#set-admin-pass').value='';
  toast('Pengaturan disimpan');
  renderLandingInfo();
});

$('#btn-reset-data').addEventListener('click', async ()=>{
  if(!confirm('Yakin reset SEMUA data peserta, pemenang, dan stok hadiah? Tindakan ini permanen.')) return;
  records = [];
  rewards = DEFAULT_REWARDS.map(r=>({...r}));
  await storSet(KEYS.RECORDS, records);
  await storSet(KEYS.REWARDS, rewards);
  renderOverview(); renderRewardsList(); renderRecordsTable();
  toast('Semua data direset');
});

/* =========================================================
   INIT
   ========================================================= */
(async function init(){
  await loadAll();
  renderLandingInfo();
})();

})();
</script>
